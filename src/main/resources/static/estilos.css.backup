/*
 * Librero — Rediseño formal azul / claros.
 * Paleta: azul marino profundo, azul institucional, grises azulados muy claros.
 * Sin librerías externas, sin CDN: funciona únicamente con pilas del sistema.
 */

:root {
  /* Fondo y superficies */
  --fondo: #F8FAFC;
  --fondo-alt: #F1F5F9;
  --superficie: #FFFFFF;
  --borde: #E2E8F0;
  --borde-fuerte: #CBD5E1;

  /* Azules institucionales */
  --navy: #0F172A;
  --azul-marino: #1E3A8A;
  --primario: #1D4ED8;
  --primario-hover: #2563EB;
  --acento-claro: #EFF6FF;
  --acento: #DBEAFE;

  /* Texto */
  --texto: #0F172A;
  --texto-secundario: #1E293B;
  --mutado: #64748B;

  /* Estados semánticos (solo para estados críticos) */
  --ok: #059669;
  --entrada: #059669;
  --salida: #D97706;
  --alerta: #DC2626;
  --alerta-fondo: #FEF2F2;

  --max-width: 1180px;
  --radio: 10px;
  --sombra: 0 1px 2px rgba(15, 23, 42, 0.06), 0 4px 12px rgba(15, 23, 42, 0.04);
}

* { box-sizing: border-box; margin: 0; padding: 0; }
html, body { min-height: 100%; background: var(--fondo); color: var(--texto); }
body {
  font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
  font-size: 15px;
}
button, input, select { font-family: inherit; font-size: inherit; }
a { color: var(--primario); }

/* ---------- Encabezado ---------- */
.app-header {
  background: var(--navy);
  color: #fff;
  padding: 0.85rem 1.25rem;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 1rem 1.5rem;
  box-shadow: 0 2px 10px rgba(15, 23, 42, 0.18);
}
.marca { display: flex; flex-direction: column; }
.logo { font-size: 1.6rem; font-weight: 750; letter-spacing: 0.4px; color: #fff; line-height: 1.1; }
.subtitulo { color: var(--acento); font-size: 0.82rem; }
.menu { display: flex; gap: 0.4rem; flex-wrap: wrap; }
.menu-btn {
  padding: 0.5rem 0.95rem;
  border: 1px solid rgba(255, 255, 255, 0.22);
  background: rgba(255, 255, 255, 0.06);
  color: #E2E8F0;
  border-radius: 8px;
  cursor: pointer;
  font-weight: 600;
  font-size: 0.9rem;
  transition: background 0.15s, border-color 0.15s, color 0.15s;
}
.menu-btn:hover { background: rgba(255, 255, 255, 0.14); color: #fff; }
.menu-btn.activo {
  background: var(--primario);
  border-color: var(--primario-hover);
  color: #fff;
  box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.12) inset;
}
.ip-footer { margin-left: auto; color: #94A3B8; font-size: 0.8rem; }

/* ---------- Estructura ---------- */
.main { max-width: var(--max-width); margin: 0 auto; padding: 1.5rem 1rem 2rem; }
.panel {
  background: var(--superficie);
  border: 1px solid var(--borde);
  border-radius: 12px;
  padding: 1.4rem;
  margin-bottom: 1.5rem;
  box-shadow: var(--sombra);
}
/* G3: la navegación depende exclusivamente de .activa */
.panel:not(.activa) { display: none; }

.panel-cabecera {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  padding-bottom: 0.9rem;
  margin-bottom: 1.2rem;
  border-bottom: 1px solid var(--borde);
}
.panel-title { color: var(--navy); font-size: 1.35rem; font-weight: 700; letter-spacing: -0.01em; }
.panel-subtitulo { color: var(--mutado); font-size: 0.85rem; margin-top: 0.15rem; }
.toolbar { display: flex; flex-wrap: wrap; gap: 0.6rem; }

/* ---------- Botones ---------- */
.btn-principal, .btn-secundario, .btn-link, .btn-link-error {
  border-radius: 8px;
  font-weight: 650;
  cursor: pointer;
  text-align: center;
  transition: background 0.15s, box-shadow 0.15s, transform 0.08s, opacity 0.15s;
}
.btn-principal, .btn-secundario { padding: 0.55rem 1.05rem; border: 1px solid transparent; font-size: 0.92rem; }
.btn-principal { background: var(--primario); color: #fff; }
.btn-principal:hover { background: var(--primario-hover); }
.btn-secundario { background: var(--acento-claro); color: var(--azul-marino); border-color: var(--acento); }
.btn-secundario:hover { background: var(--acento); }
.btn-principal:active, .btn-secundario:active { transform: translateY(1px); }
.btn-principal:disabled, .btn-secundario:disabled { opacity: 0.55; cursor: progress; }
.btn-link { background: none; color: var(--primario); text-decoration: underline; padding: 0; font-size: 0.9rem; }
.btn-link-error { color: var(--alerta); }
.btn-pequeño { padding: 0.3rem 0.65rem; font-size: 0.82rem; border-radius: 6px; }
.cargando::after { content: " …"; opacity: 0.8; }

/* ---------- Tarjetas del panel ---------- */
.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
  gap: 1rem;
  margin-bottom: 1.1rem;
}
.card {
  background: var(--superficie);
  border: 1px solid var(--borde);
  border-top: 3px solid var(--primario);
  border-radius: var(--radio);
  padding: 1.05rem 1rem;
  text-align: center;
  box-shadow: var(--sombra);
}
.card.destacado { border-top-color: var(--azul-marino); }
.card.alerta { border-top-color: var(--alerta); }
.card h3 {
  margin: 0 0 0.45rem;
  font-size: 0.72rem;
  font-weight: 700;
  color: var(--mutado);
  text-transform: uppercase;
  letter-spacing: 0.055em;
}
.card .numero {
  font-size: 1.95rem;
  font-weight: 750;
  color: var(--navy);
  font-variant-numeric: tabular-nums;
  line-height: 1.1;
}
.card.destacado .numero { color: var(--azul-marino); }
.card.alerta .numero { color: var(--alerta); }
.card-ancho { border-top-color: var(--acento); text-align: left; }
.card-ancho h3 { font-size: 0.8rem; }

.mini-tabla { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
.mini-tabla th, .mini-tabla td {
  border-bottom: 1px solid var(--borde);
  padding: 0.45rem 0.55rem;
  text-align: left;
  color: var(--texto-secundario);
  font-variant-numeric: tabular-nums;
}
.mini-tabla th { color: var(--mutado); font-size: 0.72rem; text-transform: uppercase; }

/* ---------- Formularios en cuadrícula ---------- */
.form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1rem 1.25rem;
}
.field { display: flex; flex-direction: column; gap: 0.35rem; min-width: 0; }
.field label, .label-buscar {
  font-size: 0.74rem;
  font-weight: 700;
  color: var(--mutado);
  text-transform: uppercase;
  letter-spacing: 0.045em;
}
.field input[type="text"], .field input[type="number"], .field input[type="date"],
.field input[type="time"], .filtro {
  padding: 0.58rem 0.7rem;
  border: 1px solid var(--borde-fuerte);
  border-radius: 8px;
  font-size: 0.94rem;
  color: var(--texto);
  background: var(--superficie);
  transition: border-color 0.15s, box-shadow 0.15s;
  min-width: 0;
}
.field input:focus, .filtro:focus {
  outline: none;
  border-color: var(--primario);
  box-shadow: 0 0 0 3px var(--acento);
  background: var(--acento-claro);
}
.field input::placeholder, .filtro::placeholder { color: #94A3B8; }
.field input.error-validacion { border-color: var(--alerta); box-shadow: 0 0 0 3px var(--alerta-fondo); }
.field.col2 { grid-column: span 2; }
.form-actions { display: flex; gap: 0.7rem; align-items: center; flex-wrap: wrap; }
.hint-small { color: var(--mutado); font-size: 0.8rem; margin-top: 0.85rem; }
.mutado { color: var(--mutado); }

/* ---------- Buscador de salida (UX1) ---------- */
.buscador {
  background: var(--acento-claro);
  border: 1px solid var(--acento);
  border-radius: var(--radio);
  padding: 1rem;
  margin-bottom: 1.2rem;
  position: relative;
}
.buscador-cabecera { display: flex; align-items: center; margin-bottom: 0.6rem; }
.buscador-cabecera.segunda { margin: 1.2rem 0 0.7rem; }
.etiqueta-seccion {
  font-size: 0.72rem;
  font-weight: 750;
  color: var(--azul-marino);
  text-transform: uppercase;
  letter-spacing: 0.06em;
}
.buscador-fila { display: flex; flex-wrap: wrap; gap: 0.6rem; align-items: center; }
.buscador-fila input {
  flex: 1 1 280px;
  padding: 0.58rem 0.7rem;
  border: 1px solid var(--borde-fuerte);
  border-radius: 8px;
  background: var(--superficie);
  color: var(--texto);
}
.buscador-fila input:focus { outline: none; border-color: var(--primario); box-shadow: 0 0 0 3px var(--acento); }
.datos-libro {
  margin-top: 0.7rem;
  padding: 0.55rem 0.7rem;
  background: var(--superficie);
  border: 1px solid var(--borde);
  border-left: 3px solid var(--primario);
  border-radius: 6px;
  font-size: 0.9rem;
  min-height: 2.4rem;
}
.llegada-stock-info {
  font-size: 0.78rem;
  color: var(--primario-hover);
  margin-top: 0.15rem;
  font-variant-numeric: tabular-nums;
}
.llegada-stock-info:empty { display: none; }
.sugerencias {
  position: absolute;
  z-index: 50;
  left: 1rem;
  right: 1rem;
  top: calc(100% - 0.6rem);
  background: var(--superficie);
  border: 1px solid var(--borde-fuerte);
  border-radius: 8px;
  box-shadow: 0 8px 22px rgba(15, 23, 42, 0.16);
  max-height: 230px;
  overflow-y: auto;
}
.sugerencias:empty { display: none; }
.sugerencia-item {
  display: flex;
  flex-direction: column;
  width: 100%;
  text-align: left;
  padding: 0.55rem 0.75rem;
  border: none;
  border-bottom: 1px solid var(--borde);
  background: var(--superficie);
  cursor: pointer;
  color: var(--texto);
}
.sugerencia-item:last-child { border-bottom: none; }
.sugerencia-item.activa { background: var(--acento); box-shadow: inset 3px 0 0 var(--primario); outline: none; }
.sugerencias[role="listbox"] { border: 1px solid var(--borde-fuerte); border-radius: 8px; }
.sugerencia-item:hover, .sugerencia-item:focus { background: var(--acento-claro); outline: none; }
.sugerencia-item strong { color: var(--navy); font-size: 0.9rem; }
.sugerencia-item span { color: var(--mutado); font-size: 0.78rem; font-variant-numeric: tabular-nums; }

/* ---------- Filtros (UX3) ---------- */
.filtros { display: grid; gap: 0.9rem; margin-bottom: 1.1rem; }
.filtro-grupo {
  background: var(--fondo);
  border: 1px solid var(--borde);
  border-radius: var(--radio);
  padding: 0.8rem 0.9rem;
}
.filtro-fila { display: flex; flex-wrap: wrap; gap: 0.6rem; align-items: center; margin-top: 0.5rem; }
.filtro-fila .filtro { flex: 0 1 190px; }
.filtro-fila .btn-principal { margin-left: auto; }

/* ---------- Tablas ---------- */
.tabla-wrapper {
  overflow: auto;
  max-height: 540px;
  border: 1px solid var(--borde);
  border-radius: var(--radio);
}
.tabla { width: 100%; border-collapse: separate; border-spacing: 0; background: var(--superficie); font-size: 0.9rem; }
.tabla th, .tabla td {
  padding: 0.7rem 0.8rem;
  text-align: left;
  color: var(--texto-secundario);
  border-bottom: 1px solid var(--borde);
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}
.tabla th {
  position: sticky;
  top: 0;
  z-index: 5;
  background: var(--fondo-alt);
  color: var(--azul-marino);
  font-size: 0.73rem;
  font-weight: 750;
  text-transform: uppercase;
  letter-spacing: 0.045em;
  box-shadow: inset 0 -1px 0 var(--borde-fuerte);
}
.tabla tbody tr:hover td { background: var(--acento-claro); }
.tabla td.vacio { text-align: center; color: var(--mutado); padding: 1.6rem; white-space: normal; }
.tabla td:last-child, .tabla th:last-child { text-align: right; }
.tabla tr.poco-stock td { background: var(--alerta-fondo); }
.tabla tr.poco-stock td, .tabla tr.poco-stock th { color: var(--alerta); font-weight: 650; }

/* Pills semánticas: solo para estados */
.pill {
  display: inline-block;
  padding: 0.15rem 0.55rem;
  border-radius: 999px;
  font-size: 0.73rem;
  font-weight: 750;
  letter-spacing: 0.02em;
  line-height: 1.4;
}
.pill-entrada { background: #ECFDF5; color: var(--entrada); border: 1px solid #A7F3D0; }
.pill-salida { background: #FFFBEB; color: var(--salida); border: 1px solid #FDE68A; }
.badge-poco-stock { background: var(--alerta); color: #fff; }
.tabular { font-variant-numeric: tabular-nums; }

/* ---------- Toasts ---------- */
.toast {
  position: fixed;
  right: 1.25rem;
  top: 1.25rem;
  min-width: 280px;
  max-width: 380px;
  padding: 0.85rem 1.1rem;
  border-radius: 8px;
  color: #fff;
  font-weight: 600;
  background: var(--ok);
  box-shadow: 0 6px 18px rgba(15, 23, 42, 0.22);
  display: none;
  z-index: 200;
  animation: toast-anim 4.5s ease forwards;
}
.toast.error { background: var(--alerta); }
.toast.mostrar { display: block; }
@keyframes toast-anim {
  0% { opacity: 0; transform: translateY(-8px); }
  12% { opacity: 1; }
  85% { opacity: 1; }
  100% { opacity: 0; transform: translateY(6px); }
}

.pie { text-align: center; color: var(--mutado); font-size: 0.82rem; padding: 1rem 0 1.5rem; }

/* ---------- Responsive ---------- */
@media (min-width: 900px) {
  .filtros { grid-template-columns: 2fr 1.2fr; align-items: start; }
}
@media (max-width: 640px) {
  .app-header { padding: 0.8rem; gap: 0.7rem; }
  .logo { font-size: 1.45rem; }
  .menu { width: 100%; }
  .menu-btn { flex: 1 1 auto; padding: 0.45rem 0.6rem; font-size: 0.82rem; }
  .ip-footer { margin-left: 0; width: 100%; }
  .main { padding: 1rem 0.7rem 1.5rem; }
  .panel { padding: 1rem; border-radius: 10px; }
  .panel-cabecera { align-items: flex-start; }
  .toolbar { width: 100%; }
  .toolbar button { flex: 1 1 100%; }
  .form-grid { grid-template-columns: 1fr; }
  .field.col2 { grid-column: span 1; }
  .form-actions { flex-direction: column; align-items: stretch; }
  .form-actions button { width: 100%; }
  .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.65rem; }
  .card { padding: 0.85rem 0.7rem; }
  .card .numero { font-size: 1.5rem; }
  .card h3 { font-size: 0.66rem; }
  .card-ancho { grid-column: 1 / -1; }
  .filtro-fila .filtro { flex: 1 1 100%; width: 100%; }
  .filtro-fila .btn-principal { margin-left: 0; flex: 1 1 100%; }
  .buscador-fila .btn-secundario { flex: 1 1 100%; }
  .tabla th, .tabla td { padding: 0.55rem 0.6rem; font-size: 0.84rem; }
  .toast { left: 0.75rem; right: 0.75rem; min-width: 0; max-width: none; }
}
